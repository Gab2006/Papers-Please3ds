# ==========================================
# Papers, Please 3DS - .gitignore
# File e cartelle non necessari alla build/funzionamento della ROM
# ==========================================

# File di documentazione e note di sviluppo (inclusi file Markdown)
*.md
*.markdown
*.mdown
*.txt
*.pdf
*.docx
docs/
doc/

# File sorgente grafici e progetti di editing (non usati a runtime)
*.psd
*.ase
*.aseprite
*.xcf
*.ai
*.svg

# Pacchetti ROM compilati, eseguibili e file binari 3DS
*.cxi
*.cia
*.3ds
*.3dsx
*.elf
*.smdh
*.bin

# Archivi e file compressi
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Script di utility, conversione e toolchain di sviluppo
*.py
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.sh
*.bat
*.cmd
*.ps1
*.js
*.mjs
*.ts

# File web temporanei, scrapers e dati di configurazione / test
*.html
*.htm
*.json

# File scratch, bozze e file temporanei di sviluppo
scratch_*
scratch/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# Screenshot, log e crash dump (LPP-3DS salva screenshot BMP con tasto L)
*.bmp
screenshots/
*.log
*.dmp
*.crash
*.dump

# Configurazione agenti AI, assistenti e toolchain locale
.agents/
.gemini/
.claude/
.cursor/
.chat/
.history/
skills-lock.json

# Configurazioni IDE ed editor
.vscode/
.idea/
.vs/
*.sublime-project
*.sublime-workspace

# File di sistema operativo (Windows, macOS, Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
._*
