# ==========================================
# Papers, Please 3DS - .gitignore
# Files and directories excluded from repository
# ==========================================

# Compiled ROM packages, executables, and 3DS binary files
*.cxi
*.cia
*.3ds
*.3dsx
*.elf
*.smdh
*.bin

# Temporary files and directories from build process
_build_staging/
_temp.romfs
_temp_code.bin
_temp_comp.bin
_pack_temp.cia

# Source graphics files and editing projects (not used at runtime)
*.psd
*.ase
*.aseprite
*.xcf
*.ai
*.svg

# Archives and compressed files
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Scratch files, drafts, and temporary files
scratch_*
scratch/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# Screenshots, logs, and crash dumps
*.bmp
screenshots/
*.log
*.dmp
*.crash
*.dump

# Game save files
*.dat
papersplease_save.dat

# AI agents configuration, assistants, and local toolchains
.agents/
.gemini/
.claude/
.cursor/
.chat/
.history/
skills-lock.json
GEMINI.md


# IDE and editor configurations
.vscode/
.idea/
.vs/
*.sublime-project
*.sublime-workspace

# Operating system files (Windows, macOS, Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
._*
