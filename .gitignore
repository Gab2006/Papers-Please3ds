# ==========================================
# Papers, Please 3DS - .gitignore
# File e cartelle non necessari al repository
# ==========================================

# Pacchetti ROM compilati, eseguibili e file binari 3DS
*.cxi
*.cia
*.3ds
*.3dsx
*.elf
*.smdh
*.bin

# File e cartelle temporanee del processo di build
_build_staging/
_temp.romfs
_temp_code.bin
_temp_comp.bin
_pack_temp.cia

# File sorgente grafici e progetti di editing (non usati a runtime)
*.psd
*.ase
*.aseprite
*.xcf
*.ai
*.svg

# Archivi e file compressi
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Python bytecode e ambienti virtuali
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# File scratch, bozze e temporanei
scratch_*
scratch/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# Screenshot, log e crash dump
*.bmp
screenshots/
*.log
*.dmp
*.crash
*.dump

# File di salvataggio del gioco
*.dat
papersplease_save.dat

# Configurazione agenti AI, assistenti e toolchain locale
.agents/
.gemini/
.claude/
.cursor/
.chat/
.history/
skills-lock.json
GEMINI.md


# Configurazioni IDE ed editor
.vscode/
.idea/
.vs/
*.sublime-project
*.sublime-workspace

# File di sistema operativo (Windows, macOS, Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
._*
